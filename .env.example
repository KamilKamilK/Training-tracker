# Firebase web app config (Firebase console → Project settings → Your apps).
# These values end up in the browser bundle; they identify the project and are not secrets.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# "true" connects `npm run dev` to the local emulators started by `npm run emulators`.
VITE_USE_EMULATORS=
