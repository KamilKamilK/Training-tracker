# Firebase web app config (Firebase console → Project settings → Your apps).
# These values end up in the browser bundle; they identify the project and are not secrets.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# "true" connects `npm run dev` to the local emulators started by `npm run emulators`.
VITE_USE_EMULATORS=

# Server-only settings of the Vercel function api/exercise-videos.ts (ADR-0019). Never prefix them
# with VITE_: they are secrets. In Vercel mark them Sensitive; locally `npm run dev` reads them here.
# Supabase project (EU region) → Project Settings → API Keys: the project URL and a secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional; defaults to exercise-videos.
SUPABASE_BUCKET=
# Production only: the Firebase service account key as one-line JSON. Locally with
# VITE_USE_EMULATORS=true the function uses the emulators and does not need it.
FIREBASE_SERVICE_ACCOUNT=
