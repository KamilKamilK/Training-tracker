rules_version = '2';

// The app has no backend, so these rules are the security boundary: an account reaches only its
// own data in users/{uid}/…, and only when it is active — a verified e-mail, a document in
// `owners` (the access list until registration opens, ADR-0016) and the accepted health-data
// consent in its profile. Every write is checked for shape and types. Measurement ranges mirror
// VALIDATION_RULES.measurement in src/constants/validation.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts created with e-mail and password must confirm the address first; Google accounts
    // are verified by Google.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The account is active only with the accepted health-data consent (ADR-0015); a missing
    // profile makes get() fail, which denies the request.
    function isOwner() {
      return isVerified()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consents.health.accepted == true;
    }

    function isValidConsent(consent) {
      return consent is map
        && consent.keys().hasAll(['accepted', 'version', 'at'])
        && consent.keys().hasOnly(['accepted', 'version', 'at'])
        && consent.accepted is bool
        && consent.version is string && consent.version.size() > 0 && consent.version.size() <= 20
        && consent.at is timestamp;
    }

    // Mirrors UserProfileDocumentSchema in src/types/profile.types.ts. `roles` is set only by the
    // administrator (ADR-0016), so the account owner can neither add nor change it.
    function isValidProfile(data) {
      return data.keys().hasAll(['displayName', 'consents'])
        && data.keys().hasOnly(['displayName', 'consents', 'roles'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && data.consents is map
        && data.consents.keys().hasAll(['health'])
        && data.consents.keys().hasOnly(['health'])
        && isValidConsent(data.consents.health);
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['type', 'date', 'exercises', 'notes'])
        && data.keys().hasOnly(['type', 'date', 'exercises', 'notes', 'duration', 'completed'])
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.date is string && data.date.size() <= 40
        && data.exercises is list && data.exercises.size() <= 50
        && data.notes is string && data.notes.size() <= 2000
        && (!('duration' in data) || (data.duration is number && data.duration >= 0))
        && (!('completed' in data) || data.completed is bool);
    }

    function isValidMeasurement(data) {
      return data.keys().hasAll(['date', 'weight', 'waist'])
        && data.keys().hasOnly(['date', 'weight', 'waist', 'bodyFat', 'photos'])
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.weight is number && data.weight >= 30 && data.weight <= 300
        && data.waist is number && data.waist >= 50 && data.waist <= 200
        && (!('bodyFat' in data) || (data.bodyFat is number && data.bodyFat >= 0 && data.bodyFat <= 100))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 10));
    }

    function isValidDay(plan, day) {
      return !(day in plan) || plan[day] == null || (plan[day] is string && plan[day].size() <= 100);
    }

    function isValidWeekPlan(data) {
      return data.keys().hasOnly(['plan', 'updatedAt'])
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && data.plan is map
        && data.plan.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])
        && isValidDay(data.plan, 'monday') && isValidDay(data.plan, 'tuesday')
        && isValidDay(data.plan, 'wednesday') && isValidDay(data.plan, 'thursday')
        && isValidDay(data.plan, 'friday') && isValidDay(data.plan, 'saturday')
        && isValidDay(data.plan, 'sunday');
    }

    // Mirrors WorkoutTemplateSchema in src/types/template.types.ts and VALIDATION_RULES.template.
    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'description', 'exercises', 'category', 'estimatedDuration', 'difficulty', 'color'])
        && data.keys().hasOnly(['name', 'description', 'exercises', 'category', 'estimatedDuration', 'difficulty', 'color', 'icon', 'isCustom', 'createdAt'])
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 50
        && data.description is string && data.description.size() <= 1000
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 20
        && data.category in ['strength', 'cardio', 'hybrid', 'custom']
        && data.estimatedDuration is number && data.estimatedDuration >= 0 && data.estimatedDuration <= 600
        && data.difficulty in ['beginner', 'intermediate', 'advanced']
        && data.color is string && data.color.size() <= 40
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 16))
        && (!('isCustom' in data) || data.isCustom is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    // Any verified account keeps its own profile; a consent decision carries the server time of
    // the write, so it cannot be backdated.
    match /users/{uid} {
      function isSelf() {
        return isVerified() && request.auth.uid == uid;
      }

      allow get: if isSelf();
      allow create: if isSelf()
        && isValidProfile(request.resource.data)
        && !('roles' in request.resource.data)
        && request.resource.data.consents.health.at == request.time;
      allow update: if isSelf()
        && isValidProfile(request.resource.data)
        && request.resource.data.get('roles', null) == resource.data.get('roles', null)
        && (request.resource.data.consents.health == resource.data.consents.health
          || request.resource.data.consents.health.at == request.time);

      // The account's own journal (ADR-0005); the same access conditions as for the owner's data.
      function isActiveSelf() {
        return isOwner() && request.auth.uid == uid;
      }

      match /sessions/{sessionId} {
        allow read, delete: if isActiveSelf();
        allow create, update: if isActiveSelf() && isValidWorkout(request.resource.data);
      }

      match /measurements/{measurementId} {
        allow read, delete: if isActiveSelf();
        allow create, update: if isActiveSelf() && isValidMeasurement(request.resource.data);
      }

      match /weekPlans/{planId} {
        allow read: if isActiveSelf();
        allow create, update: if isActiveSelf() && isValidWeekPlan(request.resource.data);
      }

      match /templates/{templateId} {
        allow read, delete: if isActiveSelf();
        allow create, update: if isActiveSelf() && isValidTemplate(request.resource.data);
      }
    }

    // Created by the owner in the Firebase console; the app only checks its existence.
    match /owners/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Collections from before the per-user model (ADR-0016, pkt 7). They stay until the owner
    // confirms the migration to users/{uid}/…; removing them is a separate step.
    match /workouts/{workoutId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidWorkout(request.resource.data);
    }

    match /measurements/{measurementId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidMeasurement(request.resource.data);
    }

    match /weekPlans/{planId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && isValidWeekPlan(request.resource.data);
    }
  }
}
