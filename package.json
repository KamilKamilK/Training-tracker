{
  "name": "training-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-training-tracker \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-training-tracker \"playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-training-tracker",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^0.552.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
