# Build used by `npm run test:e2e`: a demo project on the local emulators, no real credentials.
VITE_API_KEY=demo-api-key
VITE_AUTH_DOMAIN=demo-training-tracker.firebaseapp.com
VITE_PROJECT_ID=demo-training-tracker
VITE_STORAGE_BUCKET=demo-training-tracker.appspot.com
VITE_MESSAGING_SENDER_ID=000000000000
VITE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
